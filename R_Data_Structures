thislist <- list("apple", "banana", "cherry")
newlist <- thislist[-1]
# Range through indices
(thislist)[2:5]
# Loop through a list
for (x in thislist) {
  print(x)
}
# Join two lists
list1 <- list("a", "b", "c")
list2 <- list(1,2,3)
