x=c(0.45, -0.22, 0.71, 0.3, -0.15, 0.6, 0.38, -0.12, 0.55, 0.2)
n = length(x)

#MME
mean(x)

#MLE
mle = mean(x)

#unbiased (MSE = MLE)
#E(mean) = mu; that indicates unbiased

#Variance of the estimator
var(x)/n

#CI
lower = mle - (2.57)*sqrt(var(x)/n)
upper = mle + (2.57)*sqrt(var(x)/n)
c(lower, upper)













