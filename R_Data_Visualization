# R PLOT

plot(1, 3)

# X in first vector and Y in second vector
plot(c(1, 8), c(3, 10))
plot(c(1, 2, 3, 4, 5), c(3, 7, 8, 9, 12))

x <- c(1, 2, 3, 4, 5)
y <- c(3, 7, 8, 9, 12)
plot(x, y)

plot(1:10) # creates points with the element itself like (1, 1), (2, 2) ... (10, 10)
plot(1:10, type="l") # draws a line
plot(1:10, main="My Graph", xlab="The x-axis", ylab="The y axis") # creates heading for graph along with labels for X and Y axis
plot(1:10, col="red") # colour of points
plot(1:10, cex=2) # size of data point
plot(1:10, pch=25, cex=2) # type of data point





































