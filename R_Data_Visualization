# PIE CHART

x <- c(10,20,30,40)
pie(x) # splits as percentage wise of total
pie(x, init.angle = 90) # setting up start angle

mylabel <- c("Apples", "Bananas", "Cherries", "Dates")
pie(x, label = mylabel, main = "Fruits") # Display the pie chart with labels

colors <- c("blue", "yellow", "green", "black")
pie(x, label = mylabel, main = "Fruits", col = colors) # Display the pie chart with colors

legend("bottomright", mylabel, fill = colors) # displays legend (center, bottomleft, top, topright etc.)












# BAR PLOT

x <- c("A", "B", "C", "D") # x-axis values
y <- c(2, 4, 6, 8) # y-axis values
barplot(y, names.arg = x)

barplot(y, names.arg = x, col = "red")

barplot(y, names.arg = x, density = 10)

barplot(y, names.arg = x, width = c(1,2,3,4))

barplot(y, names.arg = x, horiz = TRUE)












# MULTIPLE LINE DIAGRAM
matplot(x, type = "l")























# MORE ABOUT DATA VISUALISATION
# TITLES
title(main = " ", sub = " ")
# LABEL OF AXES
plot(x, xlab = '', ylab = ' ')
# LIMIT ODF AXES
barplot(x, xlim = c(1, 5), ylim = c(0, 100))
# CREATING LEGEND
barplot(x, legend = TRUE)
barplot(x, legend.text = c())
# BESIDE
barplot(x, beside = TRUE)
# NAMING BARS
barplot(x, names.arg = c())
# COLORS
barplot(x, col = c("steelblue", "tomato"))
