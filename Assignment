# Question 10: t-distribution convergence as df increases
set.seed(42)
df_values <- c(5, 30, 100)

par(mfrow = c(1, 3))

for (df in df_values) {
  # 1 & 2. Generate samples and plot histogram
  samples <- rt(1000, df = df)
  hist(samples,
       breaks = 40,
       freq = FALSE,
       xlim = c(-5, 5),
       main = paste("t(", df, ")"),
       xlab = "Value",
       col = "lightblue",
       border = "white")

  # 3. Overlay t density
  curve(dt(x, df = df), add = TRUE, col = "blue", lwd = 2)

  # 4. Overlay N(0,1) density
  curve(dnorm(x), add = TRUE, col = "red", lwd = 2, lty = 2)

  legend("topright",
         legend = c(paste("t(", df, ")"), "N(0,1)"),
         lty = c(1, 2), col = c("blue", "red"), lwd = 2)
}
par(mfrow = c(1, 1))

# 5 & 6. Observations
cat("5 & 6. Observations:\n")
cat("   As df increases: tails become lighter, shape approaches N(0,1).\n")
cat("   At df=30, t(30) is nearly indistinguishable from N(0,1).\n")
cat("   At df=100, curves overlap almost completely.\n")
cat("   => N(0,1) is a safe approximation for t(df) when df >= 30.\n")














