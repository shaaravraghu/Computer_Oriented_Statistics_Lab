    round(q_coef,3), ")x + (", round(r_coef,3), ") = 0\n")
cat("(b) Discriminant D = q^2 - 4pr =\n"); print(disc)

nature <- ifelse(disc > 0, "Real and Distinct roots",
           ifelse(disc == 0, "Real and Equal roots", "Complex (no real) roots"))
cat("    Nature of roots:", nature, "\n")

# (c): Repeat 10 times, count real roots
cat("\n(c) 10 Trials:\n")
cat(sprintf("%-8s %-8s %-8s %-12s %-25s\n",
        "Trial", "p", "q", "D", "Nature"))

real_count <- 0
for (i in 1:10) {
  p_i <- rnorm(1)
  q_i <- rnorm(1)
  r_i <- rnorm(1)
  D   <- q_i^2 - 4 * p_i * r_i
